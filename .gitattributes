# ============================================
# MAIS Management System - Git Attributes
# Handles line endings and binary files
# ============================================

# Auto detect text files and perform LF normalization
* text=auto

# ----------------------
# Source Code
# ----------------------
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.less      text eol=lf
*.html      text eol=lf
*.htm       text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# .NET / C#
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.resx      text eol=crlf
*.config    text eol=crlf

# ----------------------
# Documentation
# ----------------------
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
LICENSE     text eol=lf
AUTHORS     text eol=lf
CHANGELOG   text eol=lf

# ----------------------
# Configuration
# ----------------------
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
.env*          text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf
*.toml         text eol=lf

# Docker
Dockerfile*    text eol=lf
docker-compose* text eol=lf
*.dockerfile   text eol=lf

# ----------------------
# Scripts
# ----------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf

# Windows scripts
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ----------------------
# SQL
# ----------------------
*.sql       text eol=lf

# ----------------------
# Binary Files
# ----------------------
# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.bmp       binary
*.tiff      binary
*.tif       binary
*.psd       binary
*.ai        binary
*.eps       binary

# Fonts
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary

# Audio
*.mp3       binary
*.wav       binary
*.ogg       binary
*.flac      binary
*.aac       binary

# Video
*.mp4       binary
*.webm      binary
*.avi       binary
*.mov       binary
*.wmv       binary
*.flv       binary
*.mkv       binary

# Documents
*.pdf       binary
*.doc       binary
*.docx      binary
*.xls       binary
*.xlsx      binary
*.ppt       binary
*.pptx      binary

# Archives
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary
*.rar       binary
*.7z        binary
*.gz        binary
*.bz2       binary

# .NET Binaries
*.dll       binary
*.exe       binary
*.pdb       binary

# Database
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# Certificates
*.pfx       binary
*.p12       binary
*.cer       binary

# ----------------------
# Git LFS (if used)
# ----------------------
# Uncomment if you want to use Git LFS for large files
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text
# *.sketch filter=lfs diff=lfs merge=lfs -text

# ----------------------
# Diff settings
# ----------------------
*.cs        diff=csharp
*.css       diff=css
*.html      diff=html
*.md        diff=markdown
*.php       diff=php
*.py        diff=python
*.rb        diff=ruby

# Treat lock files as generated
package-lock.json   linguist-generated=true
yarn.lock           linguist-generated=true
pnpm-lock.yaml      linguist-generated=true

# Build output is generated
build/**            linguist-generated=true
dist/**             linguist-generated=true
