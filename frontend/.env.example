# =============================================================================
# MAIS Frontend - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Note: All variables must be prefixed with VITE_ to be accessible in the app.
# =============================================================================

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Base URL path for API requests
#
# Development (with Vite proxy):
#   VITE_API_BASE=/api
#   - Requests to /api/* are proxied to the backend server
#   - Configure the proxy in vite.config.mjs
#
# Production (direct API access):
#   VITE_API_BASE=https://your-api-domain.com/api
#   - Set this to your production API URL
# -----------------------------------------------------------------------------
VITE_API_BASE=/api

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features during development
# VITE_ENABLE_DEBUG=true
# VITE_ENABLE_MOCK_DATA=false
