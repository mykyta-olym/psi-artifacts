# =============================================================================
# MAIS Management System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string (used by Docker Compose for the API container)
# The default values match the docker-compose.yml db service configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mais

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (minimum 32 characters)
# IMPORTANT: Change this in production to a secure random string!
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_KEY=your-secret-key-minimum-32-characters-long
JWT_ISSUER=mais.local
JWT_AUDIENCE=mais.local

# -----------------------------------------------------------------------------
# EMAIL / SMTP CONFIGURATION
# -----------------------------------------------------------------------------
# Gmail App Password for sending emails (notifications, password resets, etc.)
#
# How to generate a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled
#   3. Navigate to "App passwords" section
#   4. Select "Mail" as the app and your device type
#   5. Click "Generate" and copy the 16-character password
#   6. Paste it below WITHOUT spaces (e.g., abcdwxyzabcdwxyz)
#
# Note: Regular Gmail passwords will NOT work. You must use an App Password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=MAIS System

# -----------------------------------------------------------------------------
# APPLICATION URLs
# -----------------------------------------------------------------------------
# Base URL for email links (password reset, activation, etc.)
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:4028

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Allowed origins for Cross-Origin requests (comma-separated)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4028

# -----------------------------------------------------------------------------
# GEMINI AI CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Google Gemini API for AI chat features
# Get your API key at: https://makersuite.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=models/gemini-1.5-flash-latest

# -----------------------------------------------------------------------------
# SEED DATA CONFIGURATION
# -----------------------------------------------------------------------------
# Default passwords for seeded users (leave empty for random generation)
# -----------------------------------------------------------------------------
SEED_DEFAULT_STUDENT_PASSWORD=
SEED_DEFAULT_TEACHER_PASSWORD=
SEED_GENERATE_RANDOM_PASSWORDS=false
